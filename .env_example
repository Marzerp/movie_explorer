# .env_ejemplo
MONGO_ROOT_USER=your_root_user
MONGO_ROOT_PASSWORD=your_root_password

MONGO_APP_DB=moviesdb
MONGO_APP_USER=your_app_user
MONGO_APP_PASSWORD=your_app_password

# Obtén tu API key en: https://www.themoviedb.org/settings/api
API_KEY=your_api_key

MONGO_HOST=localhost 
MONGO_PORT=27017 
